# Required: a Hardcover API token (hardcover.app -> Settings -> API).
HARDCOVER_API_TOKEN=

# Recommended: Google Books finds ebook editions (free key, 1,000 requests a day).
GOOGLE_BOOKS_API_KEY=

# Audiobooks come from Audible's catalogue. Region: us, uk, ca, au, de, fr, it, es, in, jp, or "off".
SCOUT_AUDIBLE_REGION=us

# Opt-in: also look on Goodreads (ebooks and audiobooks). Goodreads has no API, so
# this reads its public pages slowly (one request every 4 seconds).
SCOUT_GOODREADS=false

# Edition language: en, de, fr, es, it, nl, pt.
SCOUT_LANGUAGE=en

# How often followed authors are re-read from Hardcover.
SCOUT_REFRESH_INTERVAL=24h

# Books with only print editions on Hardcover are looked up from this many readers.
SCOUT_PRINT_ONLY_MIN_READERS=5
